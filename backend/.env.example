# Mongo connection string
# Local/dev (docker-compose service name "mongo"):
MONGO_URI=mongodb://mongo:27017/taskhub
# Production (self-hosted Mongo EC2 instance, private data-tier subnet):
# MONGO_URI=mongodb://<mongo-private-ip>:27017/taskhub

# Secret used to sign JWTs - generate a long random string for production
# e.g. openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string

PORT=4000
